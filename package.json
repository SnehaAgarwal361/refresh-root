{
  "name": "know-your-customer-refresh-root",
  "version": "1.0.0",
  "description": "Used to create UI for all the configurable properties in the international kyc refresh application",
  "contributors": [
    " Nagaraj VC <nagaraj.v.chandrashekar@amex.com>",
    "Chris Nicolas Gilbert <christopher.n.gilbert@aexp.com>"
  ],
  "scripts": {
    "start": "one-app-runner",
    "prebuild": "npm run clean",
    "build": "bundle-module",
    "watch:build": "npm run build -- --watch",
    "clean": "rimraf build",
    "prepare": "npm run build && npm run test:unit && npm run test:lint -- --fix && npm run test:browser",
    "pretest:a11y": "create-runner-env && one-app-runner-test",
    "pretest:browser": "npm run build && create-runner-env && one-app-runner-test",
    "test": " npm run test:lint && npm run test:unit && npm run test:browser",
    "test:a11y": "jest a11y --preset @americanexpress/jest-preset-browser",
    "test:browser": "jest /browser/ --preset @americanexpress/jest-preset-browser --runInBand",
    "test:lint": "eslint  -c .eslintrc.json --ignore-path .gitignore --ext js,jsx,snap .",
    "test:unit": "jest --testPathIgnorePatterns /browser/ /a11y/ /testMocks/"
  },
  "one-amex": {
    "app": {
      "compatibility": "^5.0.0"
    },
    "bundler": {
      "webpackConfigPath": "webpack.config.js",
      "performanceBudget": 500e3
    },
    "product-contacts": [
      "Anil Kumar Sanathi <anil.k.sanathi@aexp.com>",
      "Simon John Fletcher <simon.j.fletcher@aexp.com>"
    ],
    "runner": {
      "modules": [
        ".",
        "../axp-intranet-identity"
      ],
      "moduleMapUrl": "https://cdaas-dev.aexp.com/cdaas/one-app/map/epaas-kycrefresh-intra-kycrefresh-e1/module-map.json",
      "rootModuleName": "know-your-customer-refresh-root",
      "dockerImage": "dockerproxy.aexp.com/oneamex/one-app-dev:5",
      "envVars": {
        "ONE_CONFIG_ENV": "e1",
        "AUTHBLUE_BYPASS": "true",
        "AUTHBLUE_LOCAL_USER": "ideskov"
      }
    },
    "risk": {
      "level": "low"
    }
  },
  "dependencies": {
    "@americanexpress/browser-like-fetch": "^1.0.1",
    "@americanexpress/content-security-policy": "^2.32.0",
    "@americanexpress/dls-react": "^1.25.3",
    "@americanexpress/fetchye-amex": "^0.2.1",
    "@americanexpress/one-app-ducks": "^4.3.3",
    "@americanexpress/one-app-module-wrapper": "^3.3.1",
    "@americanexpress/one-app-router": "^1.1.0",
    "@americanexpress/react-ddl": "^0.1.4",
    "@commitlint/cli": "^15.0.0",
    "@commitlint/config-conventional": "^15.0.0",
    "@emotion/core": "^10.0.28",
    "@reduxjs/toolkit": "^1.8.0",
    "@testing-library/jest-dom": "^5.15.1",
    "@testing-library/react": "^12.1.3",
    "@testing-library/react-hooks": "^7.0.2",
    "@testing-library/user-event": "^13.5.0",
    "fetchye": "^1.1.0",
    "fetchye-one-app": "^1.1.0",
    "holocron": "^1.1.4",
    "holocron-module-route": "^1.2.1",
    "immutable": "^4.0.0",
    "mermaid": "^8.14.0",
    "prop-types": "^15.7.2",
    "react": "^16.13.1",
    "react-helmet": "^6.1.0",
    "react-intl": "^5.20.10",
    "react-redux": "^7.2.6",
    "standard-version": "^9.3.2"
  },
  "devDependencies": {
    "@americanexpress/jest-a11y": "^3.0.3",
    "@americanexpress/jest-preset-browser": "^4.2.1",
    "@americanexpress/one-app-bundler": "^6.12.0",
    "@americanexpress/one-app-runner": "^6.12.0",
    "@babel/polyfill": "^7.10.4",
    "amex-jest-preset-react": "^6.1.2",
    "babel-eslint": "^10.1.0",
    "babel-preset-amex": "^3.5.0",
    "cross-env": "^7.0.3",
    "enzyme": "^3.11.0",
    "enzyme-to-json": "^3.6.1",
    "eslint": "^7.32.0",
    "eslint-config-amex": "^15.0.0",
    "eslint-plugin-jest": "^24.5.0",
    "eslint-plugin-jest-dom": "^3.9.2",
    "husky": "^7.0.0",
    "jest": "^26.6.3",
    "jest-image-snapshot": "^4.0.2",
    "jest-serializer-html": "^7.1.0",
    "one-amex-test-utils": "^6.2.0",
    "react-dom": "^17.0.2",
    "rimraf": "^3.0.2",
    "typescript": "^4.4.3"
  },
  "jest": {
    "preset": "amex-jest-preset-react",
    "moduleNameMapper": {
      "mermaid": "<rootDir>/node_modules/mermaid/dist/mermaid.js"
    },
    "setupFiles": [
      "./test-setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "__tests__/__utils__/"
    ]
  }
}
