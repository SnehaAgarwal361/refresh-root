{
  "name": "know-your-customer-refresh-root",
  "version": "1.10.0",
  "description": "Used to create UI for all the configurable properties in the international kyc refresh application",
  "contributors": [
    "Nagaraj VC <nagaraj.v.chandrashekar@amex.com>",
    "Sreeram Iyer <Sreeram.Iyer@aexp.com>"
  ],
  "scripts": {
    "start": "one-app-runner",
    "prebuild": "npm run clean",
    "build": "bundle-module",
    "watch:build": "npm run build -- --watch",
    "clean": "rimraf build",
    "prepare": "npm run build && npm run test:unit && npm run test:lint -- --fix && npm run test:browser",
    "pretest:a11y": "create-runner-env && one-app-runner-test",
    "pretest:browser": "npm run build && create-runner-env && one-app-runner-test",
    "test": " npm run test:lint && npm run test:unit && npm run test:browser",
    "test:a11y": "jest a11y --preset @americanexpress/jest-preset-browser",
    "test:browser": "jest /browser/ --preset @americanexpress/jest-preset-browser --runInBand",
    "test:lint": "eslint  -c .eslintrc.json --ignore-path .gitignore --ext js,jsx,snap .",
    "test:unit": "jest --testPathIgnorePatterns /browser/ /a11y/ /testMocks/ /__utils__/"
  },
  "one-amex": {
    "app": {
      "compatibility": "5.x || 6.x"
    },
    "bundler": {
      "webpackConfigPath": "webpack.config.js",
      "performanceBudget": 500000
    },
    "product-contacts": [
      "Anil Kumar Sanathi <anil.k.sanathi@aexp.com>",
      "Simon John Fletcher <simon.j.fletcher@aexp.com>"
    ],
    "runner": {
      "modules": [
        "."
      ],
      "moduleMapUrl": "https://cdaas-dev.aexp.com/cdaas/one-app/map/epaas-kyc-refresh-intra-kyc-refresh-e1/module-map.json",
      "rootModuleName": "know-your-customer-refresh-root",
      "dockerImage": "artifactory.aexp.com/dockerproxy/oneamex/one-app-dev:6",
      "envVars": {
        "ONE_CONFIG_ENV": "e0"
      }
    },
    "risk": {
      "level": "low"
    }
  },
  "dependencies": {
    "@americanexpress/browser-like-fetch": "^1.0.1",
    "@americanexpress/content-security-policy": "^2.36.0",
    "@americanexpress/dls-react": "^1.31.1",
    "@americanexpress/fetchye-amex": "^0.4.0",
    "@americanexpress/one-app-ducks": "^4.3.3",
    "@americanexpress/one-app-module-wrapper": "^3.4.2",
    "@americanexpress/one-app-router": "^1.2.0",
    "@americanexpress/react-ddl": "^0.1.4",
    "@babel/traverse": "^7.26.4",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^15.0.0",
    "@emotion/core": "^10.0.28",
    "@reduxjs/toolkit": "^1.8.0",
    "@testing-library/jest-dom": "^5.15.1",
    "@testing-library/react": "^12.1.3",
    "@testing-library/react-hooks": "^7.0.2",
    "@testing-library/user-event": "^13.5.0",
    "braces": "^3.0.3",
    "browserify-sign": "^4.2.3",
    "cross-spawn": "^7.0.6",
    "d3-color": "^3.1.0",
    "decode-uri-component": "^0.2.2",
    "dompurify": "^2.5.8",
    "dset": "^3.1.4",
    "holocron": "^1.2.0",
    "holocron-module-route": "^1.2.1",
    "immutable": "^4.0.0",
    "json5": "^2.2.3",
    "loader-utils": "^3.3.1",
    "lodash.sortby": "^4.7.0",
    "mermaid": "^10.9.3",
    "prop-types": "^15.7.2",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-helmet": "^6.1.0",
    "react-hook-form": "^7.43.9",
    "react-intl": "^5.24.6",
    "react-redux": "^7.2.6",
    "semver": "^7.6.3",
    "standard-version": "^9.3.2",
    "terser": "^5.37.0",
    "test": "^3.3.0",
    "use-authblue-sso": "1.2.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@americanexpress/jest-a11y": "^3.1.1",
    "@americanexpress/jest-preset-browser": "^6.1.0",
    "@americanexpress/one-amex-test-utils": "^7.0.7",
    "@americanexpress/one-app-bundler": "^7.1.4",
    "@americanexpress/one-app-runner": "^6.21.0",
    "@babel/polyfill": "^7.10.4",
    "amex-jest-preset-react": "^8.0.1",
    "babel-eslint": "^10.1.0",
    "babel-preset-amex": "^3.5.0",
    "cross-env": "^7.0.3",
    "enzyme": "^3.11.0",
    "enzyme-to-json": "^3.6.1",
    "eslint": "^7.32.0",
    "eslint-config-amex": "^15.0.0",
    "eslint-plugin-jest": "^24.5.0",
    "eslint-plugin-jest-dom": "^3.9.2",
    "husky": "^7.0.0",
    "jest": "^26.6.3",
    "jest-image-snapshot": "^4.0.2",
    "jest-serializer-html": "^7.1.0",
    "react-dom": "^17.0.2",
    "rimraf": "^3.0.2",
    "typescript": "^4.4.3"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12",
    "@swc/core": "1.7.24",
    "puppeteer-core": {
      "ws": "^8.18.0"
    },
    "micromatch": {
      "braces": "^3.0.3"
    }
  },
  "jest": {
    "preset": "amex-jest-preset-react",
    "moduleNameMapper": {
      "mermaid": "<rootDir>/node_modules/mermaid/dist/mermaid.js"
    },
    "setupFiles": [
      "./test-setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "__tests__/__utils__/"
    ]
  },
  "engines": {
    "node": "=16.x.x",
    "npm": "=8.x.x"
  }
}
